# Optional. Fishbowl doesn't need a .env: keys typed on the settings page are stored in data/secrets.json (mode 600).
# Use a .env only if you prefer to manage keys this way: copy this to .env and `chmod 600 .env`. A key set here wins and
# is locked on the settings page (shown as "set in .env / docker-compose.yml").

# Run the dashboard as another user than 1000:1000 (the data folder must belong to it; the collector: install.sh --uid)
# PUID=1000
# PGID=1000

# qBittorrent WebUI login (tip: reuse the one Sonarr/Radarr already use)
QBIT_USER=
QBIT_PASS=

# Seerr / Overseerr / Jellyseerr: Settings -> General -> API Key
SEERR_KEY=

# Tautulli: Settings -> Web Interface -> API key
TAUTULLI_KEY=
