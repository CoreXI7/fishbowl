# Optional secrets for homelab-dash. Copy to .env and `chmod 600 .env`.
# You can instead type them on the /settings page. A key set here is locked there (shown as "set in the environment").

# qBittorrent WebUI login (tip: reuse the one Sonarr/Radarr already use)
QBIT_USER=
QBIT_PASS=

# Seerr / Overseerr / Jellyseerr: Settings -> General -> API Key
SEERR_KEY=

# Tautulli: Settings -> Web Interface -> API key
TAUTULLI_KEY=
